{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node"],
    "declarationDir": "./types",
    "paths": {
      "nitro/cache": ["./node_modules/nitro/dist/runtime/cache.d.mts"]
    }
  },
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "proxy.d.ts",
    "editing.d.ts",
    "routes.d.ts",
    "errors.d.ts",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "api"
  ]
}

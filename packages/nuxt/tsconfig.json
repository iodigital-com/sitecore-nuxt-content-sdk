{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "declarationDir": "./types"
  },
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "proxy.d.ts",
    "editing.d.ts",
    "routes.d.ts",
    "errors.d.ts",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "api",
    "src/typedoc-entry.ts"
  ],
  "include": ["src/**/*"]
}

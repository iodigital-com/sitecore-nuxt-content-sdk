{
  "name": "@sitecore-content-sdk/nuxt",
  "version": "2.0.0-canary.20",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "del-cli dist types",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "vitest run",
    "generate-docs": "npx typedoc --plugin typedoc-plugin-markdown --outputFileStrategy Members --parametersFormat table --readme none --out ../../ref-docs/nuxt --entryPoints src/index.ts --githubPages false",
    "prepublishOnly": "npm run build",
    "coverage": "vitest run --coverage",
    "route-test": "vitest run test/route-test",
    "route-test:server": "tsx test/route-test/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@sitecore-content-sdk/analytics-core": "2.0.0-canary.20",
    "@sitecore-content-sdk/personalize": "2.0.0-canary.20",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "cross-env": "^10.1.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.32.0",
    "nitro": "^3.0.260311-beta",
    "nuxt": "^4.4.2",
    "regex-parser": "^2.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@sitecore-content-sdk/analytics-core": "^2.0.0-canary.20",
    "@sitecore-content-sdk/personalize": "^2.0.0-canary.20",
    "nuxt": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@sitecore-content-sdk/content": "workspace:*",
    "@sitecore-content-sdk/core": "workspace:*",
    "@sitecore-content-sdk/vue": "workspace:*",
    "h3": "^1.0.0",
    "std-env": "^4.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./client": {
      "import": "./dist/esm/client/index.js",
      "require": "./dist/cjs/client/index.js",
      "types": "./types/client/index.d.ts"
    },
     "./config": {
      "import": "./dist/esm/config/index.js",
      "require": "./dist/cjs/config/index.js",
      "types": "./types/config/index.d.ts"
    },
    "./config-cli": {
      "import": "./dist/esm/config-cli/index.js",
      "require": "./dist/cjs/config-cli/index.js",
      "types": "./types/config-cli/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/esm/middleware/index.js",
      "require": "./dist/cjs/middleware/index.js",
      "types": "./types/middleware/index.d.ts"
    },
    "./monitoring": {
      "import": "./dist/esm/monitoring/index.js",
      "require": "./dist/cjs/monitoring/index.js",
      "types": "./types/monitoring/index.d.ts"
    },
    "./route-handler": {
      "import": "./dist/esm/route-handler/index.js",
      "require": "./dist/cjs/route-handler/index.js",
      "types": "./types/route-handler/index.d.ts"
    },
    "./search": {
      "import": "./dist/esm/search/index.js",
      "require": "./dist/cjs/search/index.js",
      "types": "./types/search/index.d.ts"
    },
    "./tools": {
      "import": "./dist/esm/tools/index.js",
      "require": "./dist/cjs/tools/index.js",
      "types": "./types/tools/index.d.ts"
    },
    "./utils": {
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js",
      "types": "./types/utils/index.d.ts"
    }
  },
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "/*.js",
    "/*.d.ts"
  ]
}

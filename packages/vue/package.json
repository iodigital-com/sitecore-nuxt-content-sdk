{
  "name": "@sitecore-content-sdk/vue",
  "version": "1.0.0",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig-esm.json",
    "clean": "del-cli dist types",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "generate-docs": "npx typedoc --plugin typedoc-plugin-markdown --outputFileStrategy Members --parametersFormat table --readme none --out ../../ref-docs/vue --entryPoints src/typedoc-entry.ts --githubPages false"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@types/chai": "^5.2.2",
    "@types/jsdom": "^28.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.4",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^3.2.9",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/compiler-sfc": "^3.5.31",
    "@vue/test-utils": "^2.4.0",
    "chai": "^4.4.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.32.0",
    "jsdom": "^29.0.1",
    "nyc": "^17.1.0",
    "sinon": "^20.0.0",
    "sinon-chai": "^3.7.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.4.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@sitecore-content-sdk/content": "workspace:*",
    "@sitecore-content-sdk/core": "workspace:*"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "/*.js",
    "/*.d.ts"
  ]
}

{
  "name": "@sitecore-content-sdk/vue",
  "version": "2.1.0",
  "main": "dist/cjs/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "clean": "del-cli dist types",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "generate-docs": "npx typedoc --plugin typedoc-plugin-markdown --outputFileStrategy Members --parametersFormat table --readme none --out ../../ref-docs/vue --entryPoints src/typedoc-entry.ts --githubPages false"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/compiler-sfc": "^3.5.31",
    "@vue/test-utils": "^2.4.0",
    "del-cli": "^6.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.0.1",
    "nyc": "^17.1.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.31",
    "vue-eslint-parser": "^10.4.0"
  },
  "peerDependencies": {
    "typescript": "^5.4.0",
    "vue": "^3.5.31"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@sitecore-content-sdk/content": "^2.1.0",
    "@sitecore-content-sdk/core": "^2.1.0",
    "@sitecore-content-sdk/events": "^2.1.0",
    "@sitecore-content-sdk/search": "^0.3.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./types/index.d.ts"
    },
    "./search": {
      "import": "./dist/esm/search/index.js",
      "types": "./types/search/index.d.ts"
    }
  },
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "/*.js",
    "/*.d.ts"
  ]
}

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "skipLibCheck": true,
    "outDir": "dist/cjs",
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types"
  },
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "api"
  ]
}

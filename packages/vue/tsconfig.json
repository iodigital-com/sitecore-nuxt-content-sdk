{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "dist/cjs",
    "rootDir": "./src",
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types",
    "skipLibCheck": true,
    "paths": { "#rsc-env": ["./src/rsc-utils/rsc.d.ts"] }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "api"
  ]
}

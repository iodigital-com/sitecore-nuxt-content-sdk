{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "outDir": "dist/cjs",
    "types": ["node", "mocha"],
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types",
    "skipLibCheck": true,
    "paths": { "#rsc-env": ["./src/rsc-utils/rsc.d.ts"] }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "api"
  ]
}

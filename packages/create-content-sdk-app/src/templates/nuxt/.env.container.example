# To secure the Sitecore editor endpoint exposed by your Nuxt app, a secret token is used.
SITECORE_EDITING_SECRET=

# Your Sitecore site name.
NUXT_PUBLIC_DEFAULT_SITE_NAME=

# Your default app language.
NUXT_PUBLIC_DEFAULT_LANGUAGE=

# Your unified Sitecore Edge Context Id for server-side use.
SITECORE_EDGE_CONTEXT_ID=

# Your Sitecore Edge Context Id for client-side use.
NUXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# Allowed origins for CORS requests to the Sitecore editor endpoint. This should be set to the URL of your Sitecore instance(s) that will be making requests to the editor endpoint (e.g. https://designlibrary.sitecorecloud.io).
# JSS_ALLOWED_ORIGINS=https://designlibrary.sitecorecloud.io
JSS_ALLOWED_ORIGINS=

# Optional: custom Sitecore Edge Platform hostname (hostname or full URL).
NUXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=
SITECORE_EDGE_PLATFORM_HOSTNAME=

# Optional: custom Sitecore Edge API hostname (hostname or full URL).
SITECORE_EDGE_API_HOSTNAME=

# Optional: custom Experience Edge hostname for media URL rewriting (e.g. staging).
SITECORE_EXPERIENCE_EDGE_HOSTNAME=

# An optional Sitecore Personalize scope identifier.
NUXT_PUBLIC_PERSONALIZE_SCOPE=

# Optional: custom currency code for Personalize to use in recommendations and personalization rules (e.g. 'USD', 'EUR').
NUXT_PUBLIC_PERSONALIZE_CURRENCY=

# Timeout (ms) for Sitecore CDP requests to respond within. Default is 400.
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=

# Timeout (ms) for Sitecore Experience Edge requests to respond within. Default is 400.
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=

# Client ID, Secret and Rendering Host Name used for Design Library functionality
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=
SITECORE_RENDERINGHOST_NAME=